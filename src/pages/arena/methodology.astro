---
import ArenaLayout from '../../arena/layouts/ArenaLayout.astro';
import { categories, metrics } from '../../arena/lib/plugins';
import { predictionTypes } from '../../arena/lib/prediction-types/index';

/**
 * Methodik-Seite – vollständig aus den Registries generiert.
 * Jede neue Metrik bzw. Kategorie erscheint hier automatisch mit ihrer eigenen
 * Beschreibung; es gibt keine zweite Stelle, an der Formeln gepflegt werden.
 */
const allMetrics = metrics.list();
const allCategories = categories.list();
const allTypes = predictionTypes.list();
---

<ArenaLayout
  title="Methodik"
  description="Wie die Prediction Benchmarks Arena wertet: Metriken, Baselines, Lock-Nachweis und Grenzen der Aussagekraft."
>
  <main class="mx-auto max-w-4xl px-4 pb-8 pt-10">
    <h1 class="font-display text-3xl font-semibold leading-tight text-ink-50 sm:text-5xl">
      Methodik
    </h1>
    <p class="mt-4 text-base text-ink-300">
      Ein Benchmark ist nur so viel wert wie seine Nachprüfbarkeit. Diese Seite dokumentiert
      vollständig, wie hier gemessen wird – erzeugt direkt aus dem Code, der die Zahlen berechnet.
    </p>

    <section class="mt-12" aria-labelledby="lock">
      <h2 id="lock" class="font-display text-2xl font-semibold text-ink-50">
        Nachweis: vor dem Ereignis abgegeben
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-300">
        Jede Vorhersage speichert ihren Abgabezeitpunkt. Liegt er vor dem Ereigniszeitpunkt, wird sie
        in der Event-Liste als <span class="text-success-300">✓ vorab</span> markiert. Fehlt der
        Zeitstempel, erscheint bewusst keine Markierung – behauptet wird nur, was belegt ist.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-300">
        Die Datensätze liegen offen als JSON-Dateien und ihre Änderungshistorie ist öffentlich
        einsehbar. Damit ist von aussen prüfbar, dass eine Vorhersage tatsächlich vor dem Ereignis
        existierte und nachträglich nicht verändert wurde.
      </p>
    </section>

    <section class="mt-12" aria-labelledby="typen">
      <h2 id="typen" class="font-display text-2xl font-semibold text-ink-50">Arten von Vorhersagen</h2>
      <dl class="mt-4 flex flex-col gap-3">
        {
          allTypes.map((type) => (
            <div class="rounded-xl border border-ink-700/70 bg-ink-900/70 p-4">
              <dt class="font-medium text-ink-100">
                {type.label}
                <span class="ml-2 font-mono text-xs text-ink-400">{type.id}</span>
              </dt>
              <dd class="mt-1 text-sm text-ink-300">
                Eingabeformat: <span class="font-mono text-ink-200">{type.cellHint}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="metriken">
      <h2 id="metriken" class="font-display text-2xl font-semibold text-ink-50">Metriken</h2>
      <p class="mt-3 text-sm text-ink-300">
        Welche Metriken eine Kategorie anzeigt, entscheidet die Kategorie selbst. „Kleiner ist
        besser" ist bei Fehlermassen der Normalfall.
      </p>
      <div class="mt-4 flex flex-col gap-3">
        {
          allMetrics.map((metric) => (
            <div class="rounded-xl border border-ink-700/70 bg-ink-900/70 p-4">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-medium text-ink-100">{metric.label}</h3>
                <span class="font-mono text-xs text-ink-400">{metric.id}</span>
                <span
                  class="rounded-full border border-ink-700 px-2 py-0.5 text-[10px] uppercase tracking-wider text-ink-400"
                >
                  {metric.betterDirection === 'lower' ? 'kleiner ist besser' : 'grösser ist besser'}
                </span>
                {metric.requiresBaseline && (
                  <span class="rounded-full border border-ink-700 px-2 py-0.5 text-[10px] uppercase tracking-wider text-ink-400">
                    braucht Baseline
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-300">{metric.description}</p>
              <p class="mt-2 font-mono text-[11px] text-ink-500">
                gilt für: {metric.appliesTo.includes('*') ? 'alle Vorhersagearten' : metric.appliesTo.join(', ')}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="baselines">
      <h2 id="baselines" class="font-display text-2xl font-semibold text-ink-50">
        Baselines je Kategorie
      </h2>
      <p class="mt-3 text-sm text-ink-300">
        Die wichtigste Frage ist nicht „wie gut ist der Wert?", sondern „schlägt das Modell die
        etablierte Referenz?". Kategorien ohne belastbare Referenz zeigen bewusst keinen Skill-Score,
        statt eine erfundene Baseline zu erfinden.
      </p>
      <div class="mt-4 flex flex-col gap-3">
        {
          allCategories.map((category) => (
            <div class="rounded-xl border border-ink-700/70 bg-ink-900/70 p-4">
              <div class="flex items-center gap-2">
                <span
                  class="h-2.5 w-2.5 rounded-full"
                  style={`background-color:${category.accent}`}
                  aria-hidden="true"
                />
                <h3 class="font-medium text-ink-100">{category.label}</h3>
              </div>
              <p class="mt-2 text-sm text-ink-300">
                Gewertet: <span class="text-ink-200">{category.question}</span>
              </p>
              <p class="mt-1 text-sm text-ink-300">
                Ranking nach{' '}
                <span class="text-ink-200">
                  {metrics.find(category.primaryMetric)?.label ?? category.primaryMetric}
                </span>
              </p>
              <p class="mt-1 text-sm text-ink-300">
                {category.baselineNote ?? 'Keine Baseline – daher kein Skill-Score in dieser Kategorie.'}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="grenzen">
      <h2 id="grenzen" class="font-display text-2xl font-semibold text-ink-50">
        Grenzen der Aussagekraft
      </h2>
      <ul class="mt-3 flex flex-col gap-2 text-sm leading-relaxed text-ink-300">
        <li>
          <span class="text-ink-100">Stichprobengrösse.</span> Jede Tabelle zeigt die Spalte
          „Gewertet". Bei wenigen Events entscheidet Zufall mehr als Können – Rangfolgen sind dann
          nicht belastbar. Konfidenzintervalle sind für eine spätere Ausbaustufe vorgesehen.
        </li>
        <li>
          <span class="text-ink-100">Punkte sind nicht kategorieübergreifend vergleichbar.</span>
          Eine Punktsumme hängt von der Anzahl der Events ab, ein Fehlermass von der Einheit. Nur der
          Skill-Score gegenüber der Baseline ist dimensionslos und damit übertragbar.
        </li>
        <li>
          <span class="text-ink-100">Proper Scoring Rules statt Trefferquote.</span> Bei
          Wahrscheinlichkeiten ranken wir nach Brier und Log-Loss. Eine reine Trefferquote würde
          Modelle belohnen, die grundsätzlich extreme Wahrscheinlichkeiten nennen.
        </li>
        <li>
          <span class="text-ink-100">Prototyp-Status.</span> Ausser der abgeschlossenen Fussball-WM
          2026 sind alle Kategorien derzeit mit Beispieldaten gefüllt. Sie dienen dem Aufbau der
          Oberfläche, nicht der Bewertung von Modellen.
        </li>
      </ul>
    </section>
  </main>
</ArenaLayout>
