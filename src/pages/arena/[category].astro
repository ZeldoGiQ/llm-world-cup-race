---
// Kategorieseiten in der Standardsprache (Englisch, ohne Präfix).
import CategoryView from '../../arena/views/CategoryView.astro';
import { categories } from '../../arena/lib/plugins';
import {
  assertNoReservedCategoryId,
  DEFAULT_LOCALE,
} from '../../arena/lib/i18n/locales';
import registry from '../../../public/arena-data/registry.json';
import type { ArenaRegistryFile } from '../../arena/lib/types';

/**
 * Eine statische Seite pro Kategorie. Die Liste kommt aus registry.json –
 * eine neue Kategorie erscheint automatisch, ohne Änderung an dieser Datei.
 *
 * Der Kollisions-Check ist wichtig: `/arena/<segment>` bedient sowohl Kategorien
 * als auch Sprach- und Methodik-Seiten. Hieße eine Kategorie „de" oder
 * „methodology", würde eine Seite still überschrieben – deshalb lieber laut
 * scheitern als falsch ausliefern.
 */
export function getStaticPaths() {
  const file = registry as ArenaRegistryFile;
  return file.categories
    .filter((entry) => categories.has(entry.id))
    .map((entry) => {
      assertNoReservedCategoryId(entry.id);
      return { params: { category: entry.id } };
    });
}

const { category } = Astro.params;
---

<CategoryView locale={DEFAULT_LOCALE} categoryId={category!} />
