---
import ArenaApp from '../../arena/components/ArenaApp';
import ArenaLayout from '../../arena/layouts/ArenaLayout.astro';
import { categories } from '../../arena/lib/plugins';
import registry from '../../../public/arena-data/registry.json';
import type { ArenaRegistryFile } from '../../arena/lib/types';

/**
 * Eine statische Seite pro Kategorie. Die Liste kommt aus registry.json –
 * eine neue Kategorie erscheint hier automatisch, ohne Änderung an dieser Datei.
 */
export function getStaticPaths() {
  const file = registry as ArenaRegistryFile;
  return file.categories
    .filter((entry) => categories.has(entry.id))
    .map((entry) => ({ params: { category: entry.id } }));
}

const { category } = Astro.params;
const descriptor = categories.get(category!);
const isPrototype = descriptor.id !== 'football-worldcup';
---

<ArenaLayout title={descriptor.label} description={descriptor.blurb}>
  <main class="mx-auto max-w-6xl px-4 pb-8 pt-10">
    <a
      href="/arena"
      class="mb-4 inline-block text-xs text-ink-400 transition-colors hover:text-signal-300"
    >
      ← Alle Kategorien
    </a>

    <div class="flex flex-wrap items-center gap-3">
      <span
        class="h-3 w-3 rounded-full"
        style={`background-color:${descriptor.accent}`}
        aria-hidden="true"
      ></span>
      <h1 class="font-display text-3xl font-semibold leading-tight text-ink-50 sm:text-5xl">
        {descriptor.label}
      </h1>
      {
        isPrototype ? (
          <span
            class="rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider"
            style="border-color:color-mix(in srgb, var(--arena-live) 45%, transparent);background-color:color-mix(in srgb, var(--arena-live) 10%, transparent);color:var(--arena-live)"
            title="Diese Kategorie zeigt Beispieldaten zum Aufbau der Oberfläche."
          >
            Beispieldaten
          </span>
        ) : (
          <span class="rounded-full border border-success-400/45 bg-success-400/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-success-300">
            Echte Daten
          </span>
        )
      }
    </div>

    <p class="mt-4 max-w-2xl text-base text-ink-300">{descriptor.blurb}</p>
    <p class="mt-2 font-mono text-xs text-ink-400">
      Vorhergesagt wird: <span class="text-ink-200">{descriptor.question}</span>
    </p>

    <div class="mt-10">
      <ArenaApp categoryId={descriptor.id} client:load />
    </div>
  </main>
</ArenaLayout>
