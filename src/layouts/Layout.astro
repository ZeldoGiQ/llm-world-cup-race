---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LLM WM-Tipprunde 2026',
  description = 'KI-Modelle tippen die Fussball-WM 2026: alle Tipps öffentlich, Ergebnisse automatisch, Leaderboard live. Ein ZELDOgiq-Experiment.',
} = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0c10" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="min-h-screen bg-ink-950 font-sans text-ink-100 antialiased selection:bg-signal-400/30 selection:text-ink-50"
  >
    <slot />
  </body>
</html>
