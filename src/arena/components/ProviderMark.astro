---
/**
 * Lab-Glyphe neben dem Anbieternamen.
 *
 * Die Formen stammen aus dem FutureBench-Design-System (Claude Design,
 * assets/logos/): bewusst KEINE Marken-Logos, sondern neutrale geometrische
 * Zeichen je Lab – markenrechtlich unbedenklich und im Stil der Seite.
 * DeepSeek und Z.ai sind im selben Formvokabular ergänzt.
 *
 * `currentColor` statt fester Farbe: Die Glyphe erbt die Textfarbe ihrer
 * Umgebung und bleibt damit in jeder Zeile (gedämpft, hervorgehoben) richtig.
 * Unbekannte Anbieter bekommen schlicht keine Glyphe – Text genügt.
 */
interface Props {
  /** Anzeigename des Labs, z. B. "Anthropic" */
  provider: string;
  class?: string;
}

import { providerMark } from '../lib/provider-marks';

const { provider, class: className = 'h-3 w-3' } = Astro.props;
const mark = providerMark(provider);
---

{
  mark && (
    <svg
      viewBox="0 0 24 24"
      class={`inline-block shrink-0 ${className}`}
      aria-hidden="true"
      set:html={mark}
    />
  )
}
