---
/**
 * Inhalt einer Kategorieseite – eine Quelle für alle Sprachen.
 */
import ArenaApp from '../components/ArenaApp';
import { categories } from '../lib/plugins';
import { arenaPath, pick, type Locale } from '../lib/i18n/locales';
import { t } from '../lib/i18n/messages';
import ArenaLayout from '../layouts/ArenaLayout.astro';

interface Props {
  locale: Locale;
  categoryId: string;
}

const { locale, categoryId } = Astro.props;
const translate = t(locale);
const descriptor = categories.get(categoryId);
const label = pick(descriptor.label, locale);
const blurb = pick(descriptor.blurb, locale);
// Nur die WM enthält echte Daten; alles andere ist zum Aufbau der Oberfläche da.
const isSampleData = descriptor.id !== 'football-worldcup';
---

<ArenaLayout locale={locale} sub={descriptor.id} title={label} description={blurb}>
  <main class="mx-auto max-w-6xl px-4 pb-8 pt-10">
    <a
      href={arenaPath(locale)}
      class="mb-4 inline-block text-xs text-ink-400 transition-colors hover:text-signal-300"
    >
      {translate('nav.backToCategories')}
    </a>

    <div class="flex flex-wrap items-center gap-3">
      <span
        class="h-3 w-3 rounded-full"
        style={`background-color:${descriptor.accent}`}
        aria-hidden="true"
      ></span>
      <h1 class="font-display text-3xl font-semibold leading-tight text-ink-50 sm:text-5xl">
        {label}
      </h1>
      {
        isSampleData ? (
          <span
            class="rounded-md border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider"
            style="border-color:color-mix(in srgb, var(--arena-live) 45%, transparent);background-color:color-mix(in srgb, var(--arena-live) 10%, transparent);color:var(--arena-live)"
            title={translate('category.sampleDataTitle')}
          >
            {translate('category.sampleData')}
          </span>
        ) : (
          <span class="rounded-md border border-success-400/45 bg-success-400/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-success-300">
            {translate('category.realData')}
          </span>
        )
      }
    </div>

    <p class="mt-4 max-w-2xl text-base text-ink-300">{blurb}</p>
    <p class="mt-2 font-mono text-xs text-ink-400">
      {translate('category.predicting')}{' '}
      <span class="text-ink-200">{pick(descriptor.question, locale)}</span>
    </p>

    <div class="mt-10">
      <ArenaApp categoryId={descriptor.id} locale={locale} client:load />
    </div>
  </main>
</ArenaLayout>
