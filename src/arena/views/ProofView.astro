---
/**
 * Belege-Seite – hierher zog alles Beweisende von der Startseite.
 *
 * Die Startseite zeigt, diese Seite belegt: Commit-Beweis, Vorlaufzeiten,
 * Kontaminations-Abstand, ein nachrechenbarer Einzelfall, Zitierformat und
 * die Grenzen der Aussagekraft. Jede Zahl kommt aus loadHomeData() – nichts
 * ist hier von Hand gepflegt.
 */
import { formatDuration, formatUtc, loadHomeData } from '../lib/home/home-data';
import { formatDate, formatInteger, formatPercent } from '../lib/i18n/format';
import { ARENA_ORIGIN, arenaPath, pick, type Locale } from '../lib/i18n/locales';
import { t } from '../lib/i18n/messages';
import { HARNESS_VERSION } from '../lib/harness/config';
import '../lib/plugins';
import ArenaLayout from '../layouts/ArenaLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const data = loadHomeData(locale);
const { provenance, kpi, featured } = data;

const scoredCount = data.live.filter((entry) => entry.state === 'scored').length;
const armedCount = data.live.filter(
  (entry) => entry.state === 'armed' || entry.state === 'awaiting',
).length;
---

<ArenaLayout
  locale={locale}
  sub="proof"
  title={translate('proof.metaTitle')}
  description={translate('proof.metaDescription')}
>
  <main class="mx-auto max-w-4xl px-4 pb-8 pt-10">
    <a href={arenaPath(locale)} class="text-sm text-ink-400 hover:text-ink-200">
      {translate('nav.backToCategories')}
    </a>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink-50">
      {translate('home.proof.heading')}
    </h1>
    <p class="mt-2 max-w-3xl text-sm text-ink-300">{translate('home.intro')}</p>

    <div class="mt-8 flex flex-col gap-4 text-[13px] leading-relaxed text-ink-300">
      <p>
        {translate('home.proof.attestedNone', {
          attested: formatInteger(provenance.attested, locale),
          total: formatInteger(provenance.scoredPredictions, locale),
          nextLock: kpi.nextLockAt ? formatUtc(kpi.nextLockAt, locale) : '—',
        })}
      </p>

      {
        provenance.leadTime && (
          <p>
            {translate('home.proof.leadTime', {
              count: formatInteger(provenance.leadTime.count, locale),
              median: formatDuration(provenance.leadTime.medianMs, locale),
              p10: formatDuration(provenance.leadTime.p10Ms, locale),
              min: formatDuration(provenance.leadTime.minMs, locale),
              under24: formatInteger(provenance.leadTime.under24h, locale),
            })}{' '}
            {translate('home.proof.batches', {
              count: formatInteger(provenance.leadTime.count, locale),
              batches: formatInteger(provenance.leadTime.batches, locale),
            })}
          </p>
        )
      }

      {
        provenance.release && (
          <p>
            {translate('home.proof.release', {
              days: formatInteger(provenance.release.days, locale),
              model: provenance.release.model.name,
              releaseDate: formatDate(provenance.release.model.releaseDate!, locale),
              firstEvent: formatUtc(provenance.release.firstEvent, locale),
            })}
            {provenance.release.excluded > 0 &&
              ` ${translate('home.proof.releaseExcluded', { count: provenance.release.excluded })}`}
          </p>
        )
      }

      <p>{translate('home.proof.harness', { version: HARNESS_VERSION })}</p>
    </div>

    {
      provenance.verify && (
        <div class="mt-8 rounded-xl border border-ink-800 bg-ink-950/50 p-4">
          <h2 class="font-display text-sm font-semibold text-ink-100">
            {translate('home.proof.verifyHeading')}
          </h2>
          <dl class="mt-2 grid gap-x-4 gap-y-1 text-[13px] sm:grid-cols-[auto_1fr]">
            <dt class="text-ink-400">{translate('home.proof.verifyEvent')}</dt>
            <dd class="text-ink-200">
              {provenance.verify.event.title} · {formatUtc(provenance.verify.event.utcDate, locale)} UTC
            </dd>
            <dt class="text-ink-400">{translate('home.proof.verifyPrediction')}</dt>
            <dd class="text-ink-200">
              {provenance.verify.model.name} ·{' '}
              {translate('home.proof.verifyRecorded', {
                date: formatUtc(provenance.verify.prediction.createdAt, locale),
                lead: formatDuration(provenance.verify.leadMs, locale),
              })}
            </dd>
            <dt class="text-ink-400">{translate('home.proof.verifyOutcome')}</dt>
            <dd class="text-ink-200">{provenance.verify.outcome.detail}</dd>
          </dl>
          <p class="mt-3 text-[12px] text-ink-400">{translate('home.proof.verifyCommand')}</p>
          <div class="mt-1 overflow-x-auto">
            <code class="block whitespace-pre font-mono text-[11px] text-signal-300">
              git log --format='%H %cI' -- public/arena-data/{provenance.verify.category.id}/predictions.json
            </code>
          </div>
        </div>
      )
    }

    <div class="mt-8 border-t border-ink-800 pt-5 text-[13px] text-ink-300">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
        {translate('home.proof.citeHeading')}
      </h2>
      <p class="mt-1 select-all font-mono text-[12px] text-ink-200">
        {translate('home.proof.cite', {
          domain: ARENA_ORIGIN.replace('https://', ''),
          category: featured ? pick(featured.descriptor.label, locale) : '—',
          resolved: formatInteger(featured?.standings?.resolvedEvents ?? 0, locale),
          date: data.updatedAt ? formatUtc(data.updatedAt, locale) : '—',
        })}
      </p>
      <p class="mt-3 text-ink-400">{translate('home.proof.earlyAccess')}</p>
    </div>

    <h2 class="mt-10 font-display text-lg font-semibold text-ink-50">
      {translate('home.limits.heading')}
    </h2>
    <ul class="mt-2 flex flex-col gap-2 text-[13px] leading-relaxed text-ink-300">
      <li>
        {translate('home.limits.mix', {
          scored: scoredCount,
          armed: armedCount,
          example: data.example.length,
          total: data.categories.length,
        })}
      </li>
      {
        provenance.agreement && (
          <li>
            {translate('home.limits.correlation', {
              identical: formatInteger(provenance.agreement.identical, locale),
              pairs: formatInteger(provenance.agreement.pairs, locale),
              share: formatPercent(provenance.agreement.identical / provenance.agreement.pairs, locale, 0),
            })}
          </li>
        )
      }
      <li>{translate('home.limits.pipeline')}</li>
    </ul>
    <a
      href={arenaPath(locale, 'methodology')}
      class="mt-3 inline-block text-sm font-medium text-signal-300 transition-colors hover:text-signal-400"
    >
      {translate('home.limits.link')}
    </a>
  </main>
</ArenaLayout>
