---
/**
 * Startseite = DAS Leaderboard. Eine Quelle für alle Sprachen.
 *
 * Nach dem Leitsatz des Umbaus: Die Startseite erklärt nicht – sie zeigt.
 * Ein Besucher sieht in fünf Sekunden, wer führt, mit welchem Prediction
 * Score, und wie sicher das ist. Alles Erklärende lebt auf /proof, /models
 * und /methodology.
 *
 * Kein JavaScript: Tabs sind Links, Teilen läuft über Intent-URLs, die
 * Share-Karte ist ein statisch gebautes SVG. Keine Kategorie-, Metrik- oder
 * Modell-ID ist hier verdrahtet – alles kommt aus loadHomeData().
 */
import { avatarTextColor, modelInitials } from '../../lib/format';
import { formatUtc, loadHomeData } from '../lib/home/home-data';
import { providerMark } from '../lib/provider-marks';
import { formatInteger, formatPercent } from '../lib/i18n/format';
import { arenaPath, arenaUrl, pick, type Locale } from '../lib/i18n/locales';
import { t, type MessageKey } from '../lib/i18n/messages';
import { MIN_MODEL_COVERAGE, MIN_MODELS, MIN_RESOLVED } from '../lib/scoring/overall';
import { SCORE_VERSION, TRACKS } from '../lib/scoring/score';
import '../lib/plugins';
import ArenaLayout from '../layouts/ArenaLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const data = loadHomeData(locale);

const { featured, uncertainty, answer, kpi, overall } = data;
const board = featured?.standings ?? null;

/** Hero-Währung: der Prediction Score; ohne Referenz die Kategorie-Metrik. */
const scoreColumn = board?.columns.find((column) => column.metricId === 'prediction-score');
const hasScore =
  scoreColumn !== undefined &&
  (board?.rows.some(
    (row) => row.cells.find((c) => c.metricId === 'prediction-score')?.value !== null,
  ) ?? false);
const heroMetricId = hasScore ? 'prediction-score' : (featured?.descriptor.primaryMetric ?? '');
const heroLabel = hasScore
  ? (scoreColumn?.label ?? 'Prediction Score')
  : (board?.columns.find((c) => c.metricId === heroMetricId)?.label ?? '');

const heroCellOf = (row: NonNullable<typeof board>['rows'][number]) =>
  row.cells.find((cell) => cell.metricId === heroMetricId);

/** Medaillen erst ab P(#1) ≥ 90 % – darunter „no clear leader". */
const leaderProbability = board?.rows[0]
  ? (uncertainty?.probabilityFirst[board.rows[0].model.id] ?? 0)
  : 0;
const clearLeader = leaderProbability >= 0.9;

function rankChipClass(rank: number): string {
  if (clearLeader && rank >= 1 && rank <= 3) return `arena-rank-${rank}`;
  if (rank > 0) return 'border-ink-700 bg-ink-800/60 text-ink-300';
  return 'border-dashed border-ink-700 text-ink-500';
}

/**
 * Balken- und Whisker-Geometrie in Prozent der Score-Achse.
 * Nullpunkt der Achse = Score 0 = die Referenz; kein abgeschnittener Ursprung.
 */
const scoredRows = (board?.rows ?? []).filter((row) => row.scored > 0);
const axisMax = hasScore
  ? Math.max(
      1,
      ...scoredRows.map((row) => {
        const value = heroCellOf(row)?.value?.value ?? 0;
        const high = uncertainty?.valueInterval[row.model.id]?.[1] ?? value;
        return Math.max(value, high);
      }),
    ) * 1.08
  : 1;
const pct = (value: number) => `${Math.min(100, Math.max(0, (value / axisMax) * 100)).toFixed(2)}%`;

/** Zweitspalten: höchstens zwei, ohne die Hero-Währung. */
const secondaryColumns = (board?.columns ?? [])
  .filter((column) => column.metricId !== heroMetricId)
  .slice(0, 2);

const separatedPairs = (uncertainty?.pairs ?? []).filter((pair) => pair.separated);
const nameOf = (modelId: string) =>
  data.models.find((model) => model.id === modelId)?.name ?? modelId;
const separatedList = separatedPairs
  .map((pair) => `${nameOf(pair.a)}–${nameOf(pair.b)}`)
  .join(', ');

/** Tabs: Gesamt (gesperrt) + jede echte Kategorie. Reine Links, kein JS. */
const tabs = data.live.map((entry) => ({
  id: entry.id,
  label: pick(entry.descriptor.label, locale),
  href: arenaPath(locale, entry.id),
  current: entry.id === featured?.id,
  scored: entry.scoredPairs > 0,
}));

/** Teilen: Intent-URLs, keine Skripte. */
const pageUrl = arenaUrl(locale);
const shareText =
  answer.leader && featured
    ? translate('share.text', {
        score: answer.leader.formatted,
        leader: answer.leader.model.name,
        category: pick(featured.descriptor.label, locale),
      })
    : translate('meta.siteDescription');
const shareLinks = {
  x: `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`,
  whatsapp: `https://wa.me/?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`,
  card: featured && featured.scoredPairs > 0 ? `/arena/share/${featured.id}.svg` : null,
  data: featured ? `/arena-data/${featured.id}/predictions.json` : null,
};

const notQualified = overall.qualifications.filter((entry) => !entry.qualified);
const labelOf = (categoryId: string) =>
  pick(data.categories.find((entry) => entry.id === categoryId)!.descriptor.label, locale);

const knowledgeTrack = TRACKS.find((track) => track.id === 'knowledge-cap')!;
void knowledgeTrack;
---

<ArenaLayout locale={locale}>
  <main class="mx-auto max-w-5xl px-4 pb-8 pt-10">
    {/* ---------- Antwort ---------- */}
    <p class="mb-2 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-clay-400">
      {translate('home.eyebrow')}
    </p>
    <h1 class="max-w-3xl font-display text-[28px] font-semibold leading-[1.1] text-ink-50 sm:text-5xl">
      {translate('home.titleLead')}{' '}
      <span class="text-signal-400">{translate('home.titleAccent')}</span>
    </h1>

    {
      answer.variant !== 'coldStart' && answer.leader && answer.runnerUp && answer.category ? (
        <p class="mt-3 max-w-3xl text-sm text-ink-300 sm:text-base">
          {translate(answer.variant === 'clear' ? 'home.answer.clear' : 'home.answer.tied', {
            leader: answer.leader.model.name,
            runnerUp: answer.runnerUp.model.name,
            category: pick(answer.category.descriptor.label, locale),
            value: answer.leader.formatted,
            metric: answer.metricLabel ?? '',
            gap: answer.runnerUp.gap,
            pLeader: formatPercent(answer.leader.probabilityFirst, locale, 0),
            pRunnerUp: formatPercent(answer.runnerUp.probabilityFirst, locale, 0),
          })}
        </p>
      ) : (
        <p class="mt-3 max-w-3xl text-sm text-ink-300 sm:text-base">
          {translate('home.answer.coldStart', { events: formatInteger(kpi.openEvents, locale) })}
        </p>
      )
    }

    {/* ---------- Spur-Schalter ---------- */}
    <div class="mt-6 inline-flex items-center rounded-full border border-ink-700 bg-ink-900/80 p-1" title={translate('track.hint')}>
      <span class="rounded-full border border-signal-400/40 bg-signal-400/10 px-4 py-1.5 text-[13px] font-semibold text-signal-300">
        {translate('track.knowledge')}
      </span>
      <span class="px-4 py-1.5 text-[13px] font-semibold text-ink-500">
        {translate('track.web')}
        <span class="ml-2 rounded-full border border-ink-700 px-1.5 py-px text-[9px] uppercase tracking-wider text-ink-500">
          {translate('track.soon')}
        </span>
      </span>
    </div>

    {/* ---------- Tabs ---------- */}
    <nav class="mt-5 flex flex-wrap items-center gap-2" aria-label={translate('home.tabs.label')}>
      <a
        href="#overall"
        class="rounded-full border border-dashed border-ink-700 px-3.5 py-1.5 text-[13px] text-ink-400 transition-colors hover:text-ink-200"
      >
        {translate('home.tabs.overall')}
        <span class="ml-1.5 text-[10px] uppercase tracking-wider">{translate('home.tabs.locked')}</span>
      </a>
      {
        tabs.map((tab) => (
          <a
            href={tab.href}
            aria-current={tab.current ? 'page' : undefined}
            class={`rounded-full border px-3.5 py-1.5 text-[13px] transition-colors ${
              tab.current
                ? 'border-signal-400/50 bg-signal-400/10 font-semibold text-signal-300'
                : 'border-ink-700 text-ink-300 hover:border-ink-600 hover:text-ink-100'
            }`}
          >
            {tab.label}
          </a>
        ))
      }
    </nav>

    {/* ---------- DAS Leaderboard ---------- */}
    {
      featured && board && (
        <section class="mt-6" aria-labelledby="board-heading">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="board-heading" class="font-display text-xl font-semibold text-ink-50 sm:text-2xl">
              {heroLabel} · {pick(featured.descriptor.label, locale)}
            </h2>
            {!clearLeader && (
              <span
                class="rounded-full border border-ink-700 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-ink-400"
                title={translate('home.board.noClearLeaderTitle')}
              >
                {translate('home.board.noClearLeader')}
              </span>
            )}
          </div>
          <p class="mt-1 text-[13px] text-ink-300">
            {translate('home.scope.single', {
              resolved: formatInteger(board.resolvedEvents, locale),
              total: formatInteger(featured.events?.events.length ?? 0, locale),
              models: formatInteger(scoredRows.length, locale),
              metric: heroLabel,
            })}
            {' · '}
            <span class="font-mono text-[11px] text-ink-400">
              {translate('score.scale')} · {SCORE_VERSION}
            </span>
          </p>

          <div class="mt-4 overflow-x-auto rounded-2xl border border-ink-700/70 bg-ink-900/80">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-ink-400">
                  <th scope="col" class="px-4 py-3 font-medium">
                    {translate('standings.model')}
                  </th>
                  <th scope="col" class="px-4 py-3 text-right font-medium">{heroLabel}</th>
                  {secondaryColumns.map((column) => (
                    <th
                      scope="col"
                      class="hidden px-4 py-3 text-right font-medium sm:table-cell"
                      title={column.description}
                    >
                      {column.label}
                    </th>
                  ))}
                  <th scope="col" class="hidden px-4 py-3 text-right font-medium sm:table-cell">
                    {translate('home.board.colInterval')}
                  </th>
                  <th
                    scope="col"
                    class="px-4 py-3 text-right font-medium"
                    title={translate('home.board.colProbFirstTitle')}
                  >
                    {translate('home.board.colProbFirst')}
                  </th>
                </tr>
              </thead>
              <tbody>
                {scoredRows.map((row) => {
                  const hero = heroCellOf(row);
                  const value = hero?.value?.value ?? null;
                  const interval = uncertainty?.rankInterval[row.model.id];
                  const valueInterval = uncertainty?.valueInterval[row.model.id];
                  const probability = uncertainty?.probabilityFirst[row.model.id];
                  return (
                    <tr class="border-t border-ink-700/60 transition-colors hover:bg-ink-800/40">
                      <th scope="row" class="px-4 py-3 text-left font-normal">
                        <a href={arenaPath(locale, featured.id)} class="group flex items-center gap-2.5">
                          <span
                            class={`inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border font-mono text-xs font-bold tabular ${rankChipClass(row.rank)}`}
                          >
                            {row.rank > 0 ? `${row.rank}` : '–'}
                          </span>
                          <span
                            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold"
                            style={`background-color:${row.model.color};color:${avatarTextColor(row.model.color)}`}
                            aria-hidden="true"
                          >
                            {providerMark(row.model.provider) ? (
                              <svg
                                viewBox="0 0 24 24"
                                class="h-3.5 w-3.5"
                                set:html={providerMark(row.model.provider)}
                              />
                            ) : (
                              modelInitials(row.model.name)
                            )}
                          </span>
                          <span class="min-w-0">
                            <span class="block truncate font-display text-ink-50 group-hover:text-signal-300">
                              {row.model.name}
                            </span>
                            <span class="block truncate text-[11px] text-ink-400">
                              {row.model.provider}
                            </span>
                          </span>
                        </a>
                        {row.provisional && (
                          <span
                            class="mt-1 block text-[10px]"
                            style="color:var(--arena-live)"
                            title={translate('home.board.partialTitle')}
                          >
                            {translate('home.board.partial', {
                              scored: row.scored,
                              resolved: board.resolvedEvents,
                            })}
                          </span>
                        )}
                      </th>
                      <td class="px-4 py-3 text-right">
                        <span class="font-mono tabular text-lg font-bold text-signal-300">
                          {hero?.formatted ?? '—'}
                        </span>
                        {hasScore && value !== null && (
                          <span class="relative mt-1 block h-[9px] w-full min-w-[120px]">
                            <span class="absolute inset-x-0 top-[3px] h-[3px] rounded-full bg-ink-800" />
                            <span
                              class="absolute top-[3px] h-[3px] rounded-full bg-signal-400/80"
                              style={`left:0;width:${pct(Math.max(0, value))}`}
                            />
                            {valueInterval && (
                              <span
                                class="absolute top-0 h-[9px] border-x border-ink-400/80"
                                style={`left:${pct(Math.max(0, valueInterval[0]))};width:calc(${pct(Math.max(0, valueInterval[1]))} - ${pct(Math.max(0, valueInterval[0]))})`}
                              >
                                <span class="absolute inset-x-0 top-[4px] border-t border-ink-400/60" />
                              </span>
                            )}
                          </span>
                        )}
                      </td>
                      {secondaryColumns.map((column) => (
                        <td class="hidden px-4 py-3 text-right font-mono tabular text-ink-200 sm:table-cell">
                          {row.cells.find((cell) => cell.metricId === column.metricId)?.formatted ?? '—'}
                        </td>
                      ))}
                      <td class="hidden px-4 py-3 text-right font-mono tabular text-ink-300 sm:table-cell">
                        {interval ? `${interval[0]}–${interval[1]}` : '—'}
                      </td>
                      <td class="px-4 py-3 text-right font-mono tabular text-ink-200">
                        {probability === undefined ? '—' : formatPercent(probability, locale, 0)}
                      </td>
                    </tr>
                  );
                })}

                {/* Referenzzeile: Score 0 per Definition */}
                {featured.reference && hasScore && (
                  <tr class="border-t border-ink-700 bg-ink-950/40">
                    <th scope="row" class="px-4 py-3 text-left font-normal">
                      <span class="flex items-center gap-2.5">
                        <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink-700 font-mono text-[10px] text-ink-400">
                          ø
                        </span>
                        <span class="min-w-0">
                          <span class="block truncate text-ink-200">{featured.reference.label}</span>
                          <span class="block text-[11px] text-ink-400">
                            {translate('home.board.reference')}
                            {featured.reference.retroactive
                              ? ` · ${translate('home.board.retroactive')}`
                              : ''}
                          </span>
                        </span>
                      </span>
                    </th>
                    <td class="px-4 py-3 text-right font-mono tabular text-ink-300">0.0</td>
                    {secondaryColumns.map(() => (
                      <td class="hidden px-4 py-3 sm:table-cell" />
                    ))}
                    <td class="hidden px-4 py-3 sm:table-cell" />
                    <td class="px-4 py-3" />
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <p class="mt-2 text-[11px] text-ink-400 sm:hidden">{translate('home.board.scrollHint')}</p>

          {/* ---------- Teilen ---------- */}
          <div class="mt-4 flex flex-wrap items-center gap-2" aria-label={translate('share.heading')}>
            <span class="font-mono text-[10px] uppercase tracking-wider text-ink-500">
              {translate('share.heading')}
            </span>
            <a
              href={shareLinks.x}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-ink-700 px-3 py-1 text-[12px] text-ink-200 transition-colors hover:border-ink-500 hover:text-ink-50"
            >
              {translate('share.x')}
            </a>
            <a
              href={shareLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-ink-700 px-3 py-1 text-[12px] text-ink-200 transition-colors hover:border-ink-500 hover:text-ink-50"
            >
              {translate('share.whatsapp')}
            </a>
            <a
              href={shareLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-ink-700 px-3 py-1 text-[12px] text-ink-200 transition-colors hover:border-ink-500 hover:text-ink-50"
            >
              {translate('share.linkedin')}
            </a>
            {shareLinks.card && (
              <a
                href={shareLinks.card}
                download
                class="rounded-full border border-signal-400/40 px-3 py-1 text-[12px] text-signal-300 transition-colors hover:border-signal-400"
              >
                {translate('share.card')}
              </a>
            )}
            {shareLinks.data && (
              <a
                href={shareLinks.data}
                class="rounded-full border border-ink-700 px-3 py-1 font-mono text-[11px] text-ink-300 transition-colors hover:border-ink-500"
              >
                {translate('share.data')}
              </a>
            )}
          </div>

          {/* Trennschärfe */}
          {uncertainty && (
            <div class="mt-4 flex flex-col gap-1 text-[11px] leading-relaxed text-ink-400">
              {separatedPairs.length > 0 && (
                <p>
                  {translate('home.board.separablePairs', {
                    separable: separatedPairs.length,
                    pairs: uncertainty.pairs.length,
                    list: separatedList,
                  })}
                </p>
              )}
              <p>
                {translate('home.board.bootstrapNote', {
                  draws: formatInteger(uncertainty.draws, locale),
                  events: formatInteger(uncertainty.commonEvents, locale),
                  seed: String(uncertainty.seed),
                })}
              </p>
              {featured.reference && <p>{featured.reference.note}</p>}
            </div>
          )}

          <a
            href={arenaPath(locale, featured.id)}
            class="mt-3 inline-block text-sm font-medium text-signal-300 transition-colors hover:text-signal-400"
          >
            {translate('home.board.viewCategory', {
              count: formatInteger(featured.events?.events.length ?? 0, locale),
              category: pick(featured.descriptor.label, locale),
            })}
          </a>
        </section>
      )
    }

    {/* ---------- Offene Runde (eine Zeile) ---------- */}
    {
      kpi.openEvents > 0 && (
        <p class="mt-8 rounded-xl border border-ink-800 bg-ink-900/40 px-4 py-3 text-[13px] text-ink-300">
          {kpi.openPredictions > 0
            ? translate('home.open.header', {
                events: formatInteger(kpi.openEvents, locale),
                date: kpi.nextLockAt ? formatUtc(kpi.nextLockAt, locale) : '—',
                filed: formatInteger(kpi.openPredictions, locale),
                slots: formatInteger(kpi.openSlots, locale),
              })
            : translate('home.open.oneLine', {
                events: formatInteger(kpi.openEvents, locale),
                categories: formatInteger(kpi.openCategories, locale),
                date: kpi.nextLockAt ? formatUtc(kpi.nextLockAt, locale) : '—',
              })}
        </p>
      )
    }

    {/* ---------- Gesamt (gesperrt) ---------- */}
    <section
      id="overall"
      class="mt-10 rounded-2xl border border-ink-700/70 bg-ink-900/60 p-6"
      aria-labelledby="overall-heading"
    >
      <h2 id="overall-heading" class="font-display text-lg font-semibold text-ink-50">
        {overall.status === 'insufficient'
          ? translate('home.overall.lockedTitle')
          : translate('home.overall.title', {
              counted: overall.qualifiedCount,
              total: overall.totalCategories,
            })}
      </h2>
      <p class="mt-2 max-w-3xl text-[13px] text-ink-300">
        {translate('home.overall.lockedBody', {
          required: overall.requiredCategories,
          counted: overall.qualifiedCount,
        })}
      </p>
      <details class="mt-3 text-[12px] text-ink-400">
        <summary class="cursor-pointer select-none text-ink-300">
          {translate('home.overall.reasonHeading')}
        </summary>
        <p class="mt-2 max-w-3xl leading-relaxed">
          {translate('home.overall.rule', {
            minResolved: MIN_RESOLVED,
            minModels: MIN_MODELS,
            minCoverage: Math.round(MIN_MODEL_COVERAGE * 100),
          })}
        </p>
        <dl class="mt-2 grid gap-x-6 gap-y-1 sm:grid-cols-2">
          {
            notQualified.map((entry) => (
              <div class="flex justify-between gap-3 border-b border-ink-800/70 py-1">
                <dt class="text-ink-300">{labelOf(entry.categoryId)}</dt>
                <dd class="text-right">
                  {translate(`home.overall.reason.${entry.reason}` as MessageKey, {
                    resolved: entry.resolvedEvents,
                  })}
                </dd>
              </div>
            ))
          }
        </dl>
      </details>
    </section>

    {/* ---------- Fußzeile: Datenstand + Wege in die Tiefe ---------- */}
    <p class="mt-10 font-mono text-[11px] text-ink-500">
      {translate('home.footer.dataAs', {
        date: data.updatedAt ? formatUtc(data.updatedAt, locale) : '—',
        live: data.live.length,
        example: data.example.length,
        events: formatInteger(data.totalEvents, locale),
        built: formatUtc(data.builtAt, locale),
      })}
    </p>
    <p class="mt-2 text-[13px] text-ink-400">
      <a href={arenaPath(locale, 'proof')} class="text-signal-300 hover:text-signal-400">{translate('nav.proof')}</a>
      {' · '}
      <a href={arenaPath(locale, 'models')} class="text-signal-300 hover:text-signal-400">{translate('nav.models')}</a>
      {' · '}
      <a href={arenaPath(locale, 'methodology')} class="text-signal-300 hover:text-signal-400">{translate('nav.methodology')}</a>
    </p>
  </main>
</ArenaLayout>
