---
/**
 * Inhalt der Arena-Startseite – eine Quelle für alle Sprachen.
 *
 * Die Seiten unter src/pages/arena/ sind bewusst nur dünne Hüllen, die diese
 * View mit einer Sprache aufrufen. So gibt es keinen dreifach gepflegten Text.
 */
import { avatarTextColor, modelInitials } from '../../lib/format';
import modelsJson from '../data/models.json';
import { categories } from '../lib/plugins';
import { metrics } from '../lib/metrics/index';
import { arenaPath, pick, type Locale } from '../lib/i18n/locales';
import { t } from '../lib/i18n/messages';
import type { ArenaModel } from '../lib/types';
import ArenaLayout from '../layouts/ArenaLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const models = (modelsJson as ArenaModel[]).filter((model) => !model.baseline);
const tiles = categories.list();

/** Kennzahlen je Kategorie zur Build-Zeit aus den Datendateien lesen. */
async function categoryStats(id: string) {
  try {
    const events = await import(`../../../public/arena-data/${id}/events.json`);
    const list = (events.default?.events ?? []) as Array<{ status: string }>;
    return {
      total: list.length,
      resolved: list.filter((event) => event.status === 'RESOLVED').length,
    };
  } catch {
    return { total: 0, resolved: 0 };
  }
}

const stats = new Map<string, { total: number; resolved: number }>();
for (const tile of tiles) stats.set(tile.id, await categoryStats(tile.id));
---

<ArenaLayout locale={locale}>
  <main class="mx-auto max-w-6xl px-4 pb-8 pt-12">
    <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.25em] text-clay-400">
      {translate('home.eyebrow')}
    </p>
    <h1 class="font-display text-4xl font-semibold leading-tight text-ink-50 sm:text-6xl">
      {translate('home.titleLead')} <span class="text-signal-400">{translate('home.titleAccent')}</span>
    </h1>
    <p class="mt-4 max-w-2xl text-base text-ink-300 sm:text-lg">{translate('home.intro')}</p>

    <ul class="mt-6 flex flex-wrap items-center gap-2" aria-label={translate('home.modelsLabel')}>
      {
        models.map((model) => (
          <li class="flex items-center gap-2 rounded-full border border-ink-700/80 bg-ink-900/70 py-1 pl-1 pr-3 text-xs text-ink-200">
            <span
              class="flex h-6 w-6 items-center justify-center rounded-full text-[10px] font-bold"
              style={`background-color:${model.color};color:${avatarTextColor(model.color)}`}
              aria-hidden="true"
            >
              {modelInitials(model.name)}
            </span>
            {model.name}
            {model.access === 'early-access' && (
              <span
                class="rounded-full border px-1.5 text-[9px] font-semibold uppercase tracking-wider"
                style="border-color:color-mix(in srgb, var(--arena-prerelease) 45%, transparent);color:var(--arena-prerelease)"
                title={translate('model.preReleaseTitle')}
              >
                {translate('model.preRelease')}
              </span>
            )}
          </li>
        ))
      }
    </ul>

    <section class="mt-14" aria-labelledby="arena-categories">
      <h2
        id="arena-categories"
        class="mb-5 border-l-2 border-signal-400/80 pl-4 font-display text-2xl font-semibold text-ink-50 sm:text-3xl"
      >
        {translate('home.categoriesHeading')}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          tiles.map((tile) => {
            const stat = stats.get(tile.id)!;
            const rankingMetric = metrics.find(tile.primaryMetric);
            const rankingLabel = rankingMetric
              ? pick(rankingMetric.label, locale)
              : tile.primaryMetric;
            return (
              <a
                href={arenaPath(locale, tile.id)}
                class="group flex flex-col gap-3 rounded-2xl border border-ink-700/70 bg-ink-900/80 p-5 shadow-lg shadow-black/20 transition-all duration-200 hover:-translate-y-0.5 hover:border-ink-600"
              >
                <span class="flex items-center gap-2">
                  <span
                    class="h-2.5 w-2.5 rounded-full"
                    style={`background-color:${tile.accent}`}
                    aria-hidden="true"
                  />
                  <span class="font-display text-lg font-semibold text-ink-50 group-hover:text-signal-300">
                    {pick(tile.label, locale)}
                  </span>
                </span>
                <p class="flex-1 text-sm leading-relaxed text-ink-300">{pick(tile.blurb, locale)}</p>
                <dl class="flex flex-wrap gap-x-4 gap-y-1 border-t border-ink-800 pt-3 text-[11px] text-ink-400">
                  <div class="flex gap-1">
                    <dt>{translate('home.stat.events')}</dt>
                    <dd class="font-mono text-ink-200">{stat.total}</dd>
                  </div>
                  <div class="flex gap-1">
                    <dt>{translate('home.stat.resolved')}</dt>
                    <dd class="font-mono text-ink-200">{stat.resolved}</dd>
                  </div>
                  <div class="flex gap-1">
                    <dt>{translate('home.stat.ranking')}</dt>
                    <dd class="text-ink-200">{rankingLabel}</dd>
                  </div>
                </dl>
              </a>
            );
          })
        }
      </div>
    </section>

    <section
      class="mt-14 rounded-2xl border border-ink-700/70 bg-ink-900/60 p-6"
      aria-labelledby="arena-principles"
    >
      <h2 id="arena-principles" class="font-display text-xl font-semibold text-ink-50">
        {translate('home.principlesHeading')}
      </h2>
      <div class="mt-4 grid gap-5 text-sm text-ink-300 sm:grid-cols-3">
        <div>
          <p class="mb-1 font-medium text-ink-100">{translate('home.principle1.title')}</p>
          <p>{translate('home.principle1.body')}</p>
        </div>
        <div>
          <p class="mb-1 font-medium text-ink-100">{translate('home.principle2.title')}</p>
          <p>{translate('home.principle2.body')}</p>
        </div>
        <div>
          <p class="mb-1 font-medium text-ink-100">{translate('home.principle3.title')}</p>
          <p>{translate('home.principle3.body')}</p>
        </div>
      </div>
      <a
        href={arenaPath(locale, 'methodology')}
        class="mt-5 inline-block text-sm font-medium text-signal-300 transition-colors hover:text-signal-400"
      >
        {translate('home.methodologyLink')}
      </a>
    </section>
  </main>
</ArenaLayout>
