---
/**
 * Startseite der Arena – eine Quelle für alle Sprachen.
 *
 * Aufbau nach der Frage, die ein Besucher in welcher Sekunde stellt:
 *   0–2   Wer führt?              -> Antwortzeile
 *   2–8   Wie klar?               -> Tabelle mit Unsicherheit
 *   8–11  Wie viel Substanz?      -> Kennzahlen
 *   11–20 Was wird sonst gemessen -> Kategorien
 *   20–25 Läuft gerade was?       -> offene Runde
 *   25–35 Gibt es eine Gesamtwertung? -> gesperrt, mit Begründung
 *   35+   Warum glauben?          -> Belege, Feld, Grenzen
 *
 * Diese Datei enthält bewusst KEINE Kategorie-ID, keine Metrik-ID, keine
 * Modell-ID und keine eigene Arithmetik außer Balkenbreite. Alles kommt aus
 * `loadHomeData()`. Eine neue Kategorie erscheint damit ohne Änderung hier.
 *
 * Kein JavaScript: keine Insel, kein Inline-Skript. Die einzige Interaktivität
 * ist das native <details>. Ein statischer Build darf niemals Relativzeiten
 * behaupten („in 3 Stunden"), deshalb stehen alle Zeitpunkte absolut in UTC.
 */
import { avatarTextColor, modelInitials } from '../../lib/format';
import { HARNESS_VERSION } from '../lib/harness/config';
import { formatDuration, formatUtc, loadHomeData } from '../lib/home/home-data';
import { FLAG_REASON_KEY } from '../lib/home/provenance';
import { formatDate, formatInteger, formatPercent } from '../lib/i18n/format';
import { ARENA_ORIGIN, arenaPath, pick, type Locale } from '../lib/i18n/locales';
import { t, type MessageKey } from '../lib/i18n/messages';
import { MIN_MODEL_COVERAGE, MIN_MODELS, MIN_RESOLVED } from '../lib/scoring/overall';
import '../lib/plugins';
import ArenaLayout from '../layouts/ArenaLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const data = loadHomeData(locale);

const { featured, uncertainty, answer, kpi, overall, provenance } = data;
const board = featured?.standings ?? null;
const primaryMetricId = featured?.descriptor.primaryMetric ?? '';

/** Medaillen erst, wenn das führende Modell in 90 % der Ziehungen vorn liegt. */
const leaderProbability = board?.rows[0]
  ? (uncertainty?.probabilityFirst[board.rows[0].model.id] ?? 0)
  : 0;
const clearLeader = leaderProbability >= 0.9;

/** Höchstens zwei Zweitmetriken – mehr passt auf keinem Telefon. */
const secondaryColumns = (board?.columns ?? [])
  .filter((column) => column.metricId !== primaryMetricId)
  .slice(0, 2);

/**
 * Balkenbreite mit echtem Nullpunkt: Die Referenz sitzt bei 0, nicht der
 * Ursprung der Achse. Ohne das sähen 190 und 146 Punkte fast gleich lang aus.
 */
const barBase = featured?.reference?.value ?? null;
const barMax = board?.rows.reduce(
  (max, row) => (row.primaryValue !== null && row.primaryValue > max ? row.primaryValue : max),
  Number.NEGATIVE_INFINITY,
);
function barWidth(value: number | null): number | null {
  if (value === null || barBase === null || barMax === undefined) return null;
  if (!Number.isFinite(barMax) || barMax <= barBase) return null;
  const share = (value - barBase) / (barMax - barBase);
  return Math.min(1, Math.max(0.04, share)) * 100;
}

/**
 * Rangchip-Klasse. Steht hier und nicht im Template: Vergleiche mit `<=` liest
 * der Astro-Compiler in JSX-Ausdrücken als Tag-Anfang.
 *
 * Medaillen gibt es nur bei einem klaren Führenden – sonst neutrale Ziffern.
 */
function rankChipClass(rank: number): string {
  if (clearLeader && rank >= 1 && rank <= 3) return `arena-rank-${rank}`;
  if (rank > 0) return 'border-ink-700 bg-ink-800/60 text-ink-300';
  return 'border-dashed border-ink-700 text-ink-500';
}

/** Trennbare Paare als lesbare Liste – ohne Modell-IDs. */
const separatedPairs = (uncertainty?.pairs ?? []).filter((pair) => pair.separated);
const nameOf = (modelId: string) =>
  data.models.find((model) => model.id === modelId)?.name ?? modelId;
const separatedList = separatedPairs
  .map((pair) => `${nameOf(pair.a)}–${nameOf(pair.b)}`)
  .join(', ');

const exampleCategories = data.example;
const liveCategories = data.live;
const openCategories = liveCategories
  .filter((entry) => entry.openEvents > 0)
  .sort((a, b) => Date.parse(a.nextLockAt ?? '9999') - Date.parse(b.nextLockAt ?? '9999'));

const stateKey: Record<string, MessageKey> = {
  scored: 'home.cat.state.scored',
  armed: 'home.cat.state.armed',
  awaiting: 'home.cat.state.awaiting',
  example: 'home.cat.state.sample',
};

const scoredCount = liveCategories.filter((entry) => entry.state === 'scored').length;
const armedCount = liveCategories.filter(
  (entry) => entry.state === 'armed' || entry.state === 'awaiting',
).length;

const notQualified = overall.qualifications.filter((entry) => !entry.qualified);
const labelOf = (categoryId: string) =>
  pick(data.categories.find((entry) => entry.id === categoryId)!.descriptor.label, locale);
---

<ArenaLayout locale={locale}>
  <main class="mx-auto max-w-6xl px-4 pb-8 pt-10">
    {/* ---------- 1. Antwort ---------- */}
    <p class="mb-2 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-clay-400">
      {translate('home.eyebrow')}
    </p>
    <h1 class="max-w-3xl font-display text-[28px] font-semibold leading-[1.1] text-ink-50 sm:text-5xl">
      {translate('home.titleLead')}{' '}
      <span class="text-signal-400">{translate('home.titleAccent')}</span>
    </h1>

    {
      answer.variant !== 'coldStart' && answer.leader && answer.runnerUp && answer.category ? (
        <p class="mt-3 max-w-3xl text-sm text-ink-300 sm:text-base">
          {translate(answer.variant === 'clear' ? 'home.answer.clear' : 'home.answer.tied', {
            leader: answer.leader.model.name,
            runnerUp: answer.runnerUp.model.name,
            category: pick(answer.category.descriptor.label, locale),
            value: answer.leader.formatted,
            metric: answer.metricLabel ?? '',
            gap: answer.runnerUp.gap,
            pLeader: formatPercent(answer.leader.probabilityFirst, locale, 0),
            pRunnerUp: formatPercent(answer.runnerUp.probabilityFirst, locale, 0),
          })}
        </p>
      ) : (
        <p class="mt-3 max-w-3xl text-sm text-ink-300 sm:text-base">
          {translate('home.answer.coldStart', { events: formatInteger(kpi.openEvents, locale) })}
        </p>
      )
    }

    {/* ---------- 2. Leaderboard der bestbelegten Kategorie ---------- */}
    {
      featured && board && (
        <section class="mt-8" aria-labelledby="board-heading">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2
              id="board-heading"
              class="font-display text-xl font-semibold text-ink-50 sm:text-2xl"
            >
              {pick(featured.descriptor.label, locale)}
            </h2>
            {!clearLeader && (
              <span
                class="rounded-full border border-ink-700 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-ink-400"
                title={translate('home.board.noClearLeaderTitle')}
              >
                {translate('home.board.noClearLeader')}
              </span>
            )}
          </div>
          <p class="mt-1 text-[13px] text-ink-300">
            {translate('home.scope.single', {
              resolved: formatInteger(board.resolvedEvents, locale),
              total: formatInteger(featured.events?.events.length ?? 0, locale),
              models: formatInteger(board.rows.filter((row) => row.scored > 0).length, locale),
              metric: board.columns.find((c) => c.metricId === primaryMetricId)?.label ?? '',
            })}
          </p>

          <div class="mt-4 overflow-x-auto rounded-2xl border border-ink-700/70 bg-ink-900/80">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-ink-400">
                  <th scope="col" class="px-4 py-3 font-medium">
                    {translate('standings.model')}
                  </th>
                  <th scope="col" class="px-4 py-3 text-right font-medium">
                    {board.columns.find((c) => c.metricId === primaryMetricId)?.label}
                  </th>
                  {secondaryColumns.map((column) => (
                    <th
                      scope="col"
                      class="hidden px-4 py-3 text-right font-medium sm:table-cell"
                      title={column.description}
                    >
                      {column.label}
                    </th>
                  ))}
                  <th scope="col" class="hidden px-4 py-3 text-right font-medium sm:table-cell">
                    {translate('home.board.colInterval')}
                  </th>
                  <th
                    scope="col"
                    class="px-4 py-3 text-right font-medium"
                    title={translate('home.board.colProbFirstTitle')}
                  >
                    {translate('home.board.colProbFirst')}
                  </th>
                  <th scope="col" class="hidden px-4 py-3 text-right font-medium md:table-cell">
                    {translate('standings.scored')}
                  </th>
                </tr>
              </thead>
              <tbody>
                {board.rows
                  .filter((row) => row.scored > 0)
                  .map((row) => {
                    const primary = row.cells.find((cell) => cell.metricId === primaryMetricId);
                    const width = barWidth(row.primaryValue);
                    const interval = uncertainty?.rankInterval[row.model.id];
                    const probability = uncertainty?.probabilityFirst[row.model.id];
                    return (
                      <tr class="border-t border-ink-700/60 transition-colors hover:bg-ink-800/40">
                        <th scope="row" class="px-4 py-3 text-left font-normal">
                          <a
                            href={arenaPath(locale, featured.id)}
                            class="flex items-center gap-2.5 group"
                          >
                            <span
                              class={`inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border font-mono text-xs font-bold tabular ${rankChipClass(row.rank)}`}
                            >
                              {row.rank > 0 ? `${row.rank}` : '–'}
                            </span>
                            <span
                              class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold"
                              style={`background-color:${row.model.color};color:${avatarTextColor(row.model.color)}`}
                              aria-hidden="true"
                            >
                              {modelInitials(row.model.name)}
                            </span>
                            <span class="min-w-0">
                              <span class="block truncate font-display text-ink-50 group-hover:text-signal-300">
                                {row.model.name}
                              </span>
                              <span class="block truncate text-[11px] text-ink-400">
                                {row.model.provider}
                              </span>
                            </span>
                          </a>
                          {row.provisional && (
                            <span
                              class="mt-1 block text-[10px]"
                              style="color:var(--arena-live)"
                              title={translate('home.board.partialTitle')}
                            >
                              {translate('home.board.partial', {
                                scored: row.scored,
                                resolved: board.resolvedEvents,
                              })}
                            </span>
                          )}
                        </th>
                        <td class="px-4 py-3 text-right">
                          <span class="font-mono tabular text-lg font-bold text-signal-300">
                            {primary?.formatted ?? '—'}
                          </span>
                          {width !== null && (
                            <span class="mt-1 block h-[3px] w-full overflow-hidden rounded-full bg-ink-800">
                              <span
                                class="block h-full rounded-full bg-signal-400/70"
                                style={`width:${width}%`}
                              />
                            </span>
                          )}
                        </td>
                        {secondaryColumns.map((column) => (
                          <td class="hidden px-4 py-3 text-right font-mono tabular text-ink-200 sm:table-cell">
                            {row.cells.find((cell) => cell.metricId === column.metricId)
                              ?.formatted ?? '—'}
                          </td>
                        ))}
                        <td class="hidden px-4 py-3 text-right font-mono tabular text-ink-300 sm:table-cell">
                          {interval ? `${interval[0]}–${interval[1]}` : '—'}
                        </td>
                        <td class="px-4 py-3 text-right font-mono tabular text-ink-200">
                          {probability === undefined ? '—' : formatPercent(probability, locale, 0)}
                        </td>
                        <td class="hidden px-4 py-3 text-right font-mono tabular text-ink-400 md:table-cell">
                          {row.scored}
                        </td>
                      </tr>
                    );
                  })}

                {/* Referenzzeile: die Messlatte, ohne Rang */}
                {featured.reference && (
                  <tr class="border-t border-ink-700 bg-ink-950/40">
                    <th scope="row" class="px-4 py-3 text-left font-normal">
                      <span class="flex items-center gap-2.5">
                        <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink-700 font-mono text-[10px] text-ink-400">
                          ø
                        </span>
                        <span class="min-w-0">
                          <span class="block truncate text-ink-200">
                            {featured.reference.label}
                          </span>
                          <span class="block text-[11px] text-ink-400">
                            {translate('home.board.reference')}
                            {featured.reference.retroactive
                              ? ` · ${translate('home.board.retroactive')}`
                              : ''}
                          </span>
                        </span>
                      </span>
                    </th>
                    <td class="px-4 py-3 text-right font-mono tabular text-ink-200">
                      {featured.reference.formatted}
                    </td>
                    {secondaryColumns.map(() => (
                      <td class="hidden px-4 py-3 sm:table-cell" />
                    ))}
                    <td class="hidden px-4 py-3 sm:table-cell" />
                    <td class="px-4 py-3" />
                    <td class="hidden px-4 py-3 md:table-cell" />
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <p class="mt-2 text-[11px] text-ink-400 sm:hidden">
            {translate('home.board.scrollHint')}
          </p>

          {/* Trennschärfe – der ehrlichste Teil der Tabelle */}
          {uncertainty && (
            <div class="mt-3 flex flex-col gap-1 text-[11px] leading-relaxed text-ink-400">
              {separatedPairs.length > 0 && (
                <p>
                  {translate('home.board.separablePairs', {
                    separable: separatedPairs.length,
                    pairs: uncertainty.pairs.length,
                    list: separatedList,
                  })}
                </p>
              )}
              <p>
                {translate('home.board.bootstrapNote', {
                  draws: formatInteger(uncertainty.draws, locale),
                  events: formatInteger(uncertainty.commonEvents, locale),
                  seed: String(uncertainty.seed),
                })}
              </p>
              {featured.reference && <p>{featured.reference.note}</p>}
            </div>
          )}

          <a
            href={arenaPath(locale, featured.id)}
            class="mt-3 inline-block text-sm font-medium text-signal-300 transition-colors hover:text-signal-400"
          >
            {translate('home.board.viewCategory', {
              count: formatInteger(featured.events?.events.length ?? 0, locale),
              category: pick(featured.descriptor.label, locale),
            })}
          </a>
        </section>
      )
    }

    {/* ---------- 3. Kennzahlen ---------- */}
    <section class="mt-10 border-t border-ink-800 pt-5" aria-label={translate('home.kpi.scored')}>
      <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div>
          <dd class="font-mono tabular text-2xl text-ink-50">
            {formatInteger(kpi.scoredEvents, locale)}
          </dd>
          <dt class="text-[11px] text-ink-400">{translate('home.kpi.scored')}</dt>
        </div>
        <div>
          <dd class="font-mono tabular text-2xl text-ink-50">
            {formatInteger(kpi.predictions, locale)}
          </dd>
          <dt class="text-[11px] text-ink-400">{translate('home.kpi.predictions')}</dt>
        </div>
        <div>
          <dd class="font-mono tabular text-2xl text-ink-50">
            {formatInteger(kpi.modelsRanked, locale)}
          </dd>
          <dt class="text-[11px] text-ink-400">{translate('home.kpi.models')}</dt>
        </div>
        <div>
          <dd class="font-mono tabular text-2xl text-ink-50">
            {formatInteger(kpi.openEvents, locale)}
          </dd>
          <dt class="text-[11px] text-ink-400">
            {kpi.openPredictions > 0
              ? translate('home.kpi.open.filed', {
                  filed: formatInteger(kpi.openPredictions, locale),
                  slots: formatInteger(kpi.openSlots, locale),
                })
              : translate('home.kpi.open.empty')}
          </dt>
        </div>
      </dl>
      <p class="mt-3 text-[11px] text-ink-400">
        {kpi.nextLockAt &&
          `${translate('home.kpi.nextLock', { date: formatUtc(kpi.nextLockAt, locale) })} · `}
        {translate('home.kpi.onlyLive')}
      </p>
    </section>

    {/* ---------- 4. Kategorien ---------- */}
    <section class="mt-12" aria-labelledby="categories-heading">
      <h2
        id="categories-heading"
        class="mb-4 border-l-2 border-signal-400/80 pl-4 font-display text-xl font-semibold text-ink-50 sm:text-2xl"
      >
        {translate('home.categoriesHeading')}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          liveCategories.map((entry) => (
            <a
              href={arenaPath(locale, entry.id)}
              class="group flex flex-col gap-2 rounded-2xl border border-ink-700/70 bg-ink-900/80 p-5 shadow-lg shadow-black/20 transition-all duration-200 hover:-translate-y-0.5 hover:border-ink-600"
            >
              <span class="flex items-start justify-between gap-2">
                <span class="flex items-center gap-2">
                  <span
                    class="h-2.5 w-2.5 rounded-full"
                    style={`background-color:${entry.descriptor.accent}`}
                    aria-hidden="true"
                  />
                  <span class="font-display text-lg font-semibold text-ink-50 group-hover:text-signal-300">
                    {pick(entry.descriptor.label, locale)}
                  </span>
                </span>
                <span
                  class={`shrink-0 rounded-full border px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wider ${
                    entry.state === 'scored'
                      ? 'border-success-500/40 text-success-300'
                      : 'border-ink-700 text-ink-400'
                  }`}
                >
                  {translate(stateKey[entry.state]!)}
                </span>
              </span>

              {entry.state === 'scored' && entry.leader ? (
                <p class="text-[13px] text-ink-200">
                  <span class="text-ink-400">{translate('home.cat.leader')}:</span>{' '}
                  {entry.leader.model.name}{' '}
                  <span class="font-mono text-ink-300">{entry.leader.formatted}</span>
                </p>
              ) : entry.openEvents > 0 ? (
                <p class="text-[13px] text-ink-300">
                  {translate.plural('home.cat.pending', entry.openEvents)}
                  {entry.nextLockAt &&
                    ` · ${translate('home.cat.nextLock')} ${formatDate(entry.nextLockAt, locale)}`}
                </p>
              ) : (
                <p class="text-[13px] text-ink-400">{translate('home.cat.noEvents')}</p>
              )}

              <p class="flex-1 text-sm leading-relaxed text-ink-300">
                {pick(entry.descriptor.question, locale)}
              </p>

              <dl class="flex flex-wrap gap-x-4 gap-y-1 border-t border-ink-800 pt-3 text-[11px] text-ink-400">
                <div class="flex gap-1">
                  <dt>{translate('home.stat.events')}</dt>
                  <dd class="font-mono text-ink-200">{entry.events?.events.length ?? 0}</dd>
                </div>
                <div class="flex gap-1">
                  <dt>{translate('home.stat.resolved')}</dt>
                  <dd class="font-mono text-ink-200">{entry.scoredEvents}</dd>
                </div>
              </dl>

              {entry.blocked && (
                <p class="text-[11px] font-semibold" style="color:var(--arena-live)">
                  {translate('home.cat.integrity', { count: entry.integrityCount })}
                </p>
              )}
            </a>
          ))
        }
      </div>

      {/* Beispieldaten: sichtbar, aber sichtbar getrennt */}
      {
        exampleCategories.length > 0 && (
          <div class="mt-6">
            <h3 class="mb-2 font-mono text-[11px] uppercase tracking-wider text-ink-500">
              {translate('home.cat.sampleGroupHeading')}
            </h3>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {exampleCategories.map((entry) => (
                <a
                  href={arenaPath(locale, entry.id)}
                  class="flex flex-col gap-1.5 rounded-2xl border border-dashed border-ink-700 bg-ink-900/40 p-4 opacity-70 transition-opacity hover:opacity-100"
                  title={translate('home.cat.state.sampleTitle')}
                >
                  <span class="flex items-center justify-between gap-2">
                    <span class="font-display text-ink-200">
                      {pick(entry.descriptor.label, locale)}
                    </span>
                    <span
                      class="shrink-0 rounded-full border px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wider"
                      style="border-color:color-mix(in srgb, var(--arena-live) 45%, transparent);color:var(--arena-live)"
                    >
                      {translate('home.cat.state.sample')}
                    </span>
                  </span>
                  {entry.declaredDataSource === 'live' && entry.flags.length > 0 && (
                    <span class="text-[10px] text-ink-400">
                      {translate('home.cat.demoted', {
                        reason: translate(FLAG_REASON_KEY[entry.flags[0]!] as MessageKey),
                      })}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </section>

    {/* ---------- 5. Offene Runde ---------- */}
    {
      kpi.openEvents > 0 &&
        (kpi.openPredictions === 0 ? (
          <p class="mt-10 rounded-xl border border-ink-800 bg-ink-900/40 px-4 py-3 text-sm text-ink-300">
            {translate('home.open.oneLine', {
              events: formatInteger(kpi.openEvents, locale),
              categories: formatInteger(kpi.openCategories, locale),
              date: kpi.nextLockAt ? formatUtc(kpi.nextLockAt, locale) : '—',
            })}
          </p>
        ) : (
          <section class="mt-12" aria-labelledby="open-heading">
            <h2
              id="open-heading"
              class="mb-1 border-l-2 border-signal-400/80 pl-4 font-display text-xl font-semibold text-ink-50 sm:text-2xl"
            >
              {translate('home.open.heading')}
            </h2>
            <p class="mb-4 pl-4 text-[13px] text-ink-300">
              {translate('home.open.header', {
                events: formatInteger(kpi.openEvents, locale),
                date: kpi.nextLockAt ? formatUtc(kpi.nextLockAt, locale) : '—',
                filed: formatInteger(kpi.openPredictions, locale),
                slots: formatInteger(kpi.openSlots, locale),
              })}
            </p>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {openCategories.slice(0, 3).map((entry) => (
                <div class="rounded-2xl border border-ink-700/70 bg-ink-900/70 p-4">
                  <p class="flex items-center gap-2 font-display text-ink-50">
                    <span
                      class="h-2 w-2 rounded-full"
                      style={`background-color:${entry.descriptor.accent}`}
                      aria-hidden="true"
                    />
                    {pick(entry.descriptor.label, locale)}
                  </p>
                  {entry.nextLockAt && (
                    <p class="mt-1 font-mono text-[11px] text-ink-400">
                      {translate('home.open.locks', {
                        date: formatUtc(entry.nextLockAt, locale),
                      })}
                    </p>
                  )}
                  <p class="mt-2 text-[13px] text-ink-300">
                    {entry.openPredictions > 0
                      ? translate('home.open.progress', {
                          filed: entry.openPredictions,
                          slots: entry.openSlots,
                        })
                      : translate('home.open.awaiting')}
                  </p>
                </div>
              ))}
            </div>
            <p class="mt-3 text-[11px] text-ink-400">{translate('home.open.footnote')}</p>
          </section>
        ))
    }

    {/* ---------- 6. Kategorienübergreifend ---------- */}
    <section
      class="mt-12 rounded-2xl border border-ink-700/70 bg-ink-900/60 p-6"
      aria-labelledby="overall-heading"
    >
      <h2 id="overall-heading" class="font-display text-xl font-semibold text-ink-50">
        {overall.status === 'insufficient'
          ? translate('home.overall.lockedTitle')
          : translate('home.overall.title', {
              counted: overall.qualifiedCount,
              total: overall.totalCategories,
            })}
      </h2>
      <p class="mt-2 max-w-3xl text-sm text-ink-300">
        {translate('home.overall.lockedBody', {
          required: overall.requiredCategories,
          counted: overall.qualifiedCount,
        })}
      </p>
      <p class="mt-3 max-w-3xl text-[12px] leading-relaxed text-ink-400">
        {translate('home.overall.rule', {
          minResolved: MIN_RESOLVED,
          minModels: MIN_MODELS,
          minCoverage: Math.round(MIN_MODEL_COVERAGE * 100),
        })}
      </p>
      {
        notQualified.length > 0 && (
          <>
            <h3 class="mt-5 font-mono text-[11px] uppercase tracking-wider text-ink-500">
              {translate('home.overall.reasonHeading')}
            </h3>
            <dl class="mt-2 grid gap-x-6 gap-y-1 text-[13px] sm:grid-cols-2">
              {notQualified.map((entry) => (
                <div class="flex justify-between gap-3 border-b border-ink-800/70 py-1">
                  <dt class="text-ink-300">{labelOf(entry.categoryId)}</dt>
                  <dd class="text-right text-ink-400">
                    {translate(`home.overall.reason.${entry.reason}` as MessageKey, {
                      resolved: entry.resolvedEvents,
                    })}
                  </dd>
                </div>
              ))}
            </dl>
          </>
        )
      }
      <p class="mt-4 max-w-3xl text-[12px] text-ink-400">{translate('home.overall.formula')}</p>
    </section>

    {/* ---------- 7. Belege ---------- */}
    <section
      class="mt-12 rounded-2xl border border-ink-700/70 bg-ink-900/60 p-6"
      aria-labelledby="proof-heading"
    >
      {/* Bewusst ohne Vorrede: Diese Sektion besteht aus prüfbaren Zahlen. Ein
          werblicher Einleitungssatz würde sie schwächer machen, nicht stärker. */}
      <h2 id="proof-heading" class="font-display text-xl font-semibold text-ink-50">
        {translate('home.proof.heading')}
      </h2>

      <div class="mt-4 flex flex-col gap-4 text-[13px] leading-relaxed text-ink-300">
        <p>
          {translate('home.proof.attestedNone', {
            attested: formatInteger(provenance.attested, locale),
            total: formatInteger(provenance.scoredPredictions, locale),
            nextLock: kpi.nextLockAt ? formatUtc(kpi.nextLockAt, locale) : '—',
          })}
        </p>

        {
          provenance.leadTime && (
            <p>
              {translate('home.proof.leadTime', {
                count: formatInteger(provenance.leadTime.count, locale),
                median: formatDuration(provenance.leadTime.medianMs, locale),
                p10: formatDuration(provenance.leadTime.p10Ms, locale),
                min: formatDuration(provenance.leadTime.minMs, locale),
                under24: formatInteger(provenance.leadTime.under24h, locale),
              })}{' '}
              {translate('home.proof.batches', {
                count: formatInteger(provenance.leadTime.count, locale),
                batches: formatInteger(provenance.leadTime.batches, locale),
              })}
            </p>
          )
        }

        {
          provenance.release && (
            <p>
              {translate('home.proof.release', {
                days: formatInteger(provenance.release.days, locale),
                model: provenance.release.model.name,
                releaseDate: formatDate(provenance.release.model.releaseDate!, locale),
                firstEvent: formatUtc(provenance.release.firstEvent, locale),
              })}
              {provenance.release.excluded > 0 &&
                ` ${translate('home.proof.releaseExcluded', { count: provenance.release.excluded })}`}
            </p>
          )
        }

        <p>{translate('home.proof.harness', { version: HARNESS_VERSION })}</p>
      </div>

      {/* Ein einzelner nachprüfbarer Fall */}
      {
        provenance.verify && (
          <div class="mt-6 rounded-xl border border-ink-800 bg-ink-950/50 p-4">
            <h3 class="font-display text-sm font-semibold text-ink-100">
              {translate('home.proof.verifyHeading')}
            </h3>
            <dl class="mt-2 grid gap-x-4 gap-y-1 text-[13px] sm:grid-cols-[auto_1fr]">
              <dt class="text-ink-400">{translate('home.proof.verifyEvent')}</dt>
              <dd class="text-ink-200">
                {provenance.verify.event.title} ·{' '}
                {formatUtc(provenance.verify.event.utcDate, locale)} UTC
              </dd>
              <dt class="text-ink-400">{translate('home.proof.verifyPrediction')}</dt>
              <dd class="text-ink-200">
                {provenance.verify.model.name} ·{' '}
                {translate('home.proof.verifyRecorded', {
                  date: formatUtc(provenance.verify.prediction.createdAt, locale),
                  lead: formatDuration(provenance.verify.leadMs, locale),
                })}
              </dd>
              <dt class="text-ink-400">{translate('home.proof.verifyOutcome')}</dt>
              <dd class="text-ink-200">{provenance.verify.outcome.detail}</dd>
            </dl>
            <p class="mt-3 text-[12px] text-ink-400">{translate('home.proof.verifyCommand')}</p>
            <div class="mt-1 overflow-x-auto">
              <code class="block whitespace-pre font-mono text-[11px] text-signal-300">
                git log --format='%H %cI' -- public/arena-data/{provenance.verify.category.id}/predictions.json
              </code>
            </div>
          </div>
        )
      }

      <div class="mt-5 border-t border-ink-800 pt-4 text-[13px] text-ink-300">
        <h3 class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
          {translate('home.proof.citeHeading')}
        </h3>
        <p class="mt-1 select-all font-mono text-[12px] text-ink-200">
          {translate('home.proof.cite', {
            domain: ARENA_ORIGIN.replace('https://', ''),
            category: featured ? pick(featured.descriptor.label, locale) : '—',
            resolved: formatInteger(board?.resolvedEvents ?? 0, locale),
            date: data.updatedAt ? formatUtc(data.updatedAt, locale) : '—',
          })}
        </p>
        <p class="mt-3 text-ink-400">{translate('home.proof.earlyAccess')}</p>
      </div>
    </section>

    {/* ---------- 8. Feld, Grenzen, Datenstand ---------- */}
    <section class="mt-12" aria-labelledby="field-heading">
      <h2
        id="field-heading"
        class="mb-4 border-l-2 border-clay-400/80 pl-4 font-display text-xl font-semibold text-ink-50 sm:text-2xl"
      >
        {translate('home.field.heading')}
      </h2>
      <div class="overflow-x-auto rounded-2xl border border-ink-700/70 bg-ink-900/70">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="text-left text-[11px] uppercase tracking-wider text-ink-400">
              <th scope="col" class="px-4 py-3 font-medium">{translate('standings.model')}</th>
              <th scope="col" class="hidden px-4 py-3 font-medium sm:table-cell">
                {translate('home.field.colVersion')}
              </th>
              <th scope="col" class="hidden px-4 py-3 font-medium md:table-cell">
                {translate('home.field.colReleased')}
              </th>
              <th scope="col" class="px-4 py-3 text-right font-medium">
                {translate('home.field.colScored')}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              [...data.rankedModels, ...data.earlyAccessModels].map((model) => {
                const scored = data.live.reduce(
                  (sum, entry) =>
                    sum + (entry.standings?.rows.find((row) => row.model.id === model.id)?.scored ?? 0),
                  0,
                );
                return (
                  <tr class="border-t border-ink-700/60">
                    <th scope="row" class="px-4 py-2.5 text-left font-normal">
                      <span class="flex items-center gap-2">
                        <span
                          class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold"
                          style={`background-color:${model.color};color:${avatarTextColor(model.color)}`}
                          aria-hidden="true"
                        >
                          {modelInitials(model.name)}
                        </span>
                        <span class="text-ink-100">{model.name}</span>
                        {model.access === 'early-access' && (
                          <span
                            class="rounded-full border px-1.5 text-[9px] font-semibold uppercase tracking-wider"
                            style="border-color:color-mix(in srgb, var(--arena-prerelease) 45%, transparent);color:var(--arena-prerelease)"
                            title={translate('home.field.exampleEntryTitle')}
                          >
                            {translate('home.field.exampleEntry')}
                          </span>
                        )}
                      </span>
                      <span class="mt-0.5 block text-[11px] text-ink-400 sm:hidden">
                        {model.provider}
                      </span>
                    </th>
                    <td class="hidden px-4 py-2.5 font-mono text-[12px] text-ink-300 sm:table-cell">
                      {model.version ?? '—'}
                    </td>
                    <td class="hidden px-4 py-2.5 text-[12px] text-ink-300 md:table-cell">
                      {model.releaseDate ? formatDate(model.releaseDate, locale) : '—'}
                    </td>
                    <td class="px-4 py-2.5 text-right font-mono tabular text-ink-200">{scored}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <h3 class="mt-8 font-display text-lg font-semibold text-ink-50">
        {translate('home.limits.heading')}
      </h3>
      <ul class="mt-2 flex flex-col gap-2 text-[13px] leading-relaxed text-ink-300">
        <li>
          {translate('home.limits.mix', {
            scored: scoredCount,
            armed: armedCount,
            example: exampleCategories.length,
            total: data.categories.length,
          })}
        </li>
        {
          provenance.agreement && (
            <li>
              {translate('home.limits.correlation', {
                identical: formatInteger(provenance.agreement.identical, locale),
                pairs: formatInteger(provenance.agreement.pairs, locale),
                share: formatPercent(
                  provenance.agreement.identical / provenance.agreement.pairs,
                  locale,
                  0,
                ),
              })}
            </li>
          )
        }
        <li>{translate('home.limits.pipeline')}</li>
      </ul>
      <a
        href={arenaPath(locale, 'methodology')}
        class="mt-3 inline-block text-sm font-medium text-signal-300 transition-colors hover:text-signal-400"
      >
        {translate('home.limits.link')}
      </a>

      <p class="mt-8 font-mono text-[11px] text-ink-500">
        {translate('home.footer.dataAs', {
          date: data.updatedAt ? formatUtc(data.updatedAt, locale) : '—',
          live: liveCategories.length,
          example: exampleCategories.length,
          events: formatInteger(data.totalEvents, locale),
          built: formatUtc(data.builtAt, locale),
        })}
      </p>
    </section>
  </main>
</ArenaLayout>
