---
/**
 * Eigenes Layout der Arena – mehrsprachig, Design-System v2 „Rekordbuch".
 *
 * Absichtlich getrennt vom WM-Layout (src/layouts/Layout.astro): Jenes ist fest
 * auf Deutsch verdrahtet und hat keinen head-Slot. Ein eigenes Layout lässt den
 * WM-Bestand vollständig unberührt.
 *
 * Die Klasse "arena" auf <html> aktiviert den gescopten Token-Remap aus
 * arena.css (Papier & Tinte statt der dunklen WM-Palette). Dark Mode setzt
 * ein winziges Inline-Skript vor dem ersten Paint über data-theme – Nutzerwahl
 * (localStorage) vor Systemwahl; ohne JavaScript bleibt es beim Tageslicht.
 *
 * SEO: lang-Attribut je Sprache, hreflang-Alternates für alle Sprachen plus
 * x-default auf die Standardsprache, canonical auf die eigene Adresse.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/global.css';
import '../styles/arena.css';
import '../lib/plugins';
import { countCategoryDataSources } from '../lib/home/home-data';
import { shareCards } from '../lib/share/data';
import {
  ARENA_ORIGIN,
  arenaPath,
  arenaUrl,
  DEFAULT_LOCALE,
  INTL_LOCALE,
  LOCALES,
  LOCALE_NAMES,
  LOCALE_SHORT,
  OG_LOCALE,
  type Locale,
} from '../lib/i18n/locales';
import { t } from '../lib/i18n/messages';

interface Props {
  locale: Locale;
  /** Unterpfad ohne Sprache, z. B. '' | 'methodology' | 'stocks-index' */
  sub?: string;
  title?: string;
  description?: string;
}

const { locale, sub = '', title, description } = Astro.props;
const translate = t(locale);

const siteTitle = translate('meta.siteTitle');
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const pageDescription = description ?? translate('meta.siteDescription');
// Absolute Adressen: Suchmaschinen erwarten bei canonical und hreflang volle
// URLs. Konsequent ohne abschliessenden Schrägstrich, damit sich canonical und
// hreflang auf genau eine Schreibweise festlegen.
const currentUrl = arenaUrl(locale, sub);

// Der Hinweis auf Beispieldaten zählt sich selbst aus den Daten und
// verschwindet, sobald keine Beispielkategorie mehr existiert.
const dataSources = countCategoryDataSources();

// Vorschaubild beim Teilen: die Karte der beweiskräftigsten Kategorie, als
// PNG. Bewusst nicht das SVG – X, LinkedIn und WhatsApp zeigen SVG als
// og:image nicht an, der Link bliebe bildlos. Die PNG entsteht nach dem
// Astro-Build (scripts/arena/render-cards.mts); gibt es noch keine
// wertbare Kategorie, bleibt das Bild weg statt auf ein Nichts zu zeigen.
const ogCard = shareCards()[0];
const ogImage = ogCard ? `${ARENA_ORIGIN}/arena/share/${ogCard.id}.png` : null;
---

<!doctype html>
<html lang={INTL_LOCALE[locale]} class="arena scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#efebe2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14110d" />

    <script is:inline>
      // Lampenlicht vor dem ersten Paint: Nutzerwahl schlägt Systemwahl.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('arena-theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <link rel="canonical" href={currentUrl} />
    {
      LOCALES.map((alternate) => (
        <link rel="alternate" hreflang={alternate} href={arenaUrl(alternate, sub)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={arenaUrl(DEFAULT_LOCALE, sub)} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={translate('meta.ogImageAlt')} />
          {/* summary_large_image statt summary: Die kleine Variante schrumpft
              das Bild auf ein quadratisches Vorschaubildchen, in dem eine
              Rangliste unleserlich wird. */}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    {
      LOCALES.filter((alternate) => alternate !== locale).map((alternate) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[alternate]} />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/arena-favicon.svg" />
  </head>
  <body
    class="min-h-screen bg-ink-950 font-sans text-ink-100 antialiased selection:bg-signal-400/30 selection:text-ink-50"
  >
    <div class="relative isolate overflow-x-clip">
      <header class="mx-auto max-w-6xl px-4 pt-8">
        <nav
          class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm"
          aria-label={siteTitle}
        >
          <a
            href={arenaPath(locale)}
            class="flex items-center gap-2.5 font-display text-lg font-semibold text-ink-50 transition-colors hover:text-signal-400"
          >
            {/* Lorbeer in currentColor, damit das Zeichen mit dem Theme kippt;
                Rekordrot und Messing kommen aus den Tokens. */}
            <svg class="h-8 w-8 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
              <g
                fill="none"
                stroke="var(--color-ink-100)"
                stroke-width="1.8"
                stroke-linecap="round"
              >
                <path d="M17.5 42.5C9 36 7.5 23 12.5 11.5"></path>
                <path d="M30.5 42.5C39 36 40.5 23 35.5 11.5"></path>
              </g>
              <g fill="var(--color-ink-100)">
                <g transform="translate(15.6 37.4) rotate(212)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(12.6 32) rotate(224)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(10.8 25.8) rotate(236)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(10.6 19.4) rotate(248)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(11.9 13.4) rotate(260)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(32.4 37.4) rotate(-32)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(35.4 32) rotate(-44)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(37.2 25.8) rotate(-56)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(37.4 19.4) rotate(-68)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
                <g transform="translate(36.1 13.4) rotate(-80)"><path d="M0 0Q4.4-3.1 8.6 0Q4.4 3.1 0 0Z"></path></g>
              </g>
              <circle cx="24" cy="24.5" r="8.4" fill="var(--arena-red)"></circle>
              <circle
                cx="24"
                cy="24.5"
                r="6.2"
                fill="none"
                stroke="var(--arena-brass)"
                stroke-width=".9"></circle>
              <text
                x="24"
                y="29.4"
                text-anchor="middle"
                font-family="'Fraunces Variable', Georgia, serif"
                font-size="11"
                font-weight="600"
                fill="var(--color-ink-900)">1</text>
            </svg>
            {translate('nav.brand')}
          </a>
          <a
            href={arenaPath(locale, 'leaderboards')}
            class="text-ink-300 transition-colors hover:text-ink-100"
          >
            {translate('nav.leaderboards')}
          </a>
          <a href={arenaPath(locale)} class="text-ink-300 transition-colors hover:text-ink-100">
            {translate('nav.categories')}
          </a>
          <a
            href={arenaPath(locale, 'methodology')}
            class="text-ink-300 transition-colors hover:text-ink-100"
          >
            {translate('nav.methodology')}
          </a>
          <a href={arenaPath(locale, 'proof')} class="text-ink-300 transition-colors hover:text-ink-100">
            {translate('nav.proof')}
          </a>
          <a href={arenaPath(locale, 'models')} class="text-ink-300 transition-colors hover:text-ink-100">
            {translate('nav.models')}
          </a>

          <div class="ml-auto flex items-center gap-2">
            <button
              id="arena-theme-toggle"
              type="button"
              class="hidden rounded-md border border-ink-700 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-ink-400 transition-colors hover:border-signal-400 hover:text-signal-400"
              aria-label={translate('nav.theme')}
              data-label-light={translate('nav.themeLight')}
              data-label-dark={translate('nav.themeDark')}></button>

            {/* Sprachumschalter: reine Links, funktioniert ohne JavaScript und
                verweist auf genau dieselbe Seite in der anderen Sprache. */}
            <ul
              class="flex items-center overflow-hidden rounded-md border border-ink-700 bg-ink-900/80"
              aria-label={translate('nav.language')}
            >
              {
                LOCALES.map((alternate) => (
                  <li>
                    <a
                      href={arenaPath(alternate, sub)}
                      hreflang={alternate}
                      lang={alternate}
                      aria-current={alternate === locale ? 'true' : undefined}
                      title={LOCALE_NAMES[alternate]}
                      class={`block px-2.5 py-1 font-mono text-[11px] font-semibold transition-colors ${
                        alternate === locale
                          ? 'bg-ink-700 text-ink-50'
                          : 'text-ink-400 hover:text-ink-100'
                      }`}
                    >
                      {LOCALE_SHORT[alternate]}
                      <span class="sr-only"> — {LOCALE_NAMES[alternate]}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
      </header>

      <slot />

      <footer class="mt-16 border-t border-ink-800 py-8">
        <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 text-xs text-ink-400">
          <p>
            {translate('footer.projectBy')}{' '}
            <a
              class="font-semibold text-clay-400 underline decoration-ink-600 underline-offset-2 transition-colors hover:text-clay-300"
              href="https://www.youtube.com/@zeldogiq"
              rel="noopener noreferrer"
              target="_blank">ZELDOgiq</a
            >
          </p>
          {/* Impressum und Datenschutz gehören in jede Fußzeile: Sie müssen
              von jeder Seite aus mit einem Klick erreichbar sein. */}
          <p class="flex flex-wrap gap-x-4 gap-y-1">
            <a
              class="underline decoration-ink-600 underline-offset-2 transition-colors hover:text-ink-200"
              href={arenaPath(locale, 'imprint')}
            >
              {translate('legal.imprintTitle')}
            </a>
            <a
              class="underline decoration-ink-600 underline-offset-2 transition-colors hover:text-ink-200"
              href={arenaPath(locale, 'privacy')}
            >
              {translate('legal.footerPrivacy')}
            </a>
          </p>
          {
            dataSources.example > 0 && (
              <p>
                {translate('footer.prototypeNote', {
                  example: dataSources.example,
                  total: dataSources.total,
                })}
              </p>
            )
          }
        </div>
      </footer>
    </div>

    <script is:inline>
      // Theme-Umschalter: zeigt immer den Modus an, zu dem er wechselt.
      // Der Knopf ist per hidden-Klasse unsichtbar, bis JavaScript da ist –
      // ohne JavaScript gäbe es nichts zu schalten.
      (() => {
        const button = document.getElementById('arena-theme-toggle');
        if (!button) return;
        const root = document.documentElement;
        const render = () => {
          button.textContent =
            root.dataset.theme === 'dark' ? button.dataset.labelLight : button.dataset.labelDark;
        };
        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('arena-theme', next);
          } catch {}
          render();
        });
        button.classList.remove('hidden');
        render();
      })();
    </script>
  </body>
</html>
