{
  "name": "llm-wm-tipprunde",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LLM WM-Tipprunde 2026 – KI-Modelle tippen die Fussball-WM, statisch gehostet auf Vercel",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run share:png",
    "share:png": "node --experimental-strip-types scripts/arena/render-cards.mts",
    "preview": "astro preview",
    "test": "vitest run",
    "check:arena": "tsc -p tsconfig.arena.json",
    "astro": "astro",
    "arena:ingest": "node --experimental-strip-types scripts/arena/jobs/ingest.mts",
    "arena:predict": "node --experimental-strip-types scripts/arena/jobs/predict.mts",
    "arena:resolve": "node --experimental-strip-types scripts/arena/jobs/resolve.mts",
    "arena:publish": "node --experimental-strip-types scripts/arena/jobs/publish.mts",
    "arena:analytics": "node --experimental-strip-types scripts/arena/jobs/analytics.mts",
    "share:prompts": "node --experimental-strip-types scripts/arena/social-prompts.mts"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.48.0",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^5.7.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
